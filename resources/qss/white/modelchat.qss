QWidget {
    border-radius: 10px;
    background-color: rgba(199, 199, 204, 255);
}

QLabel, QLineEdit, QTextEdit {
    color: black;
    height: 26px;
    padding: 2px 6px;
    background: rgba(242, 242, 247, 255);
}

QTextEdit {
    min-height: 100px;
    margin: 4px;
    margin-bottom: 10px;
}

QLabel {
    min-width: 85px;
    max-width: 85px;
    color: black;
    height: 26px;
    padding: 2px;
    background: white;
}

QPushButton {
    color: black;
    margin: 0px 5px;
    width: 60px;
    height: 30px;
    border: 1px;
    border-radius: 6px;
    background: rgba(242, 242, 247, 255);
}

QPushButton:checked {
    background-color: rgba(174, 174, 178, 200);
}

QListWidget {
    margin: 2px;
    padding: 6px 2px;
}

QListWidget::item {
    color: black;
    padding: 5px;
    border: 0px;
    border-radius: 4px;
    margin-bottom: 4px;
    background-color: rgba(229, 229, 234, 255);
}

QListWidget::item:selected {
    background-color: rgba(174, 174, 178, 200);
}

QScrollBar {
    height: 15px;
    border: 0px;
    border-radius: 6px;
    background: rgba(242, 242, 247, 255);
}

QScrollBar::handle {
    border: 0px;
    border-radius: 6px;
    background-color: rgba(174, 174, 178, 200);
}

QScrollBar::add-line, QScrollBar::sub-line {
    background: none;
}
